# Copy to .env and adjust. Never commit the real .env file.

# Required outside debug mode. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Defaults to a SQLite file in ./instance/xuehanzi.db
# DATABASE_URL=postgresql://user:password@localhost/xuehanzi

# Set to false to stop people from creating accounts themselves
# (use `flask create-user` instead).
# ALLOW_REGISTRATION=true

# Set to true when serving over HTTPS.
# SESSION_COOKIE_SECURE=true

# Directory holding the downloaded stroke order images
# (hsk1/..., hsk2/...). Defaults to xuehanzi/static/strokeorderDownloads.
# STROKE_ORDER_DIR=/path/to/strokeorderDownloads
